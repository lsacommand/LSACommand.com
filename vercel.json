{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.lsacommand.com"
        }
      ],
      "destination": "https://lsacommand.com/:path",
      "permanent": true
    },
    {
      "source": "/case-studies/champion-pools/",
      "destination": "/case-studies/pool-contractor-b/",
      "permanent": true
    },
    {
      "source": "/case-studies/advantage-pools/",
      "destination": "/case-studies/pool-contractor-a/",
      "permanent": true
    },
    {
      "source": "/case-studies/edgewater-pools/",
      "destination": "/case-studies/pool-contractor-c/",
      "permanent": true
    },
    {
      "source": "/case-studies/champion-pools/:path*",
      "destination": "/case-studies/pool-contractor-b/",
      "permanent": true
    },
    {
      "source": "/case-studies/advantage-pools/:path*",
      "destination": "/case-studies/pool-contractor-a/",
      "permanent": true
    },
    {
      "source": "/case-studies/edgewater-pools/:path*",
      "destination": "/case-studies/pool-contractor-c/",
      "permanent": true
    },
    {
      "source": "/case-study-champion-pools.svg",
      "destination": "/case-study-pool-contractor-b.svg",
      "permanent": true
    },
    {
      "source": "/case-study-advantage-pools.jpg",
      "destination": "/case-study-pool-contractor-a.svg",
      "permanent": true
    },
    {
      "source": "/case-study-edgewater-pools.jpg",
      "destination": "/case-study-pool-contractor-c.svg",
      "permanent": true
    },
    {
      "source": "/lsa-replies-minutes-gold-star.svg",
      "destination": "/lsa-replies-in-minutes.svg",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/setup.html",
      "destination": "/setup/",
      "permanent": true
    },
    {
      "source": "/lsa-report-detail.png",
      "destination": "/lsa-report-detail-redacted.svg",
      "permanent": true
    },
    {
      "source": "/lsa-before.png",
      "destination": "/lsa-before-redacted.svg",
      "permanent": true
    },
    {
      "source": "/lsa-after.png",
      "destination": "/lsa-after-redacted.svg",
      "permanent": true
    },
    {
      "source": "/lsa-availability.png",
      "destination": "/lsa-availability-anon.svg",
      "permanent": true
    },
    {
      "source": "/review-ai-sms-example.jpg",
      "destination": "/review-request-sms-example.svg",
      "permanent": true
    }
  ]
}
